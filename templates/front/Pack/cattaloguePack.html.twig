{% extends 'front/base1.html.twig' %}

{% block content %}
<div class="container-fluid px-4 mt-4">
    <form method="get" action="{{ path('pack_filter_dql') }}">
    <div class="filters-bar mb-5 p-4 bg-white rounded-lg shadow-sm">
    <form method="get" action="{{ path('cattagPack') }}">
        <div class="row g-3">
            <div class="col-md-3">
                <select class="form-select" name="lieu">
                    <option value="">Tous les lieux</option>
                    {% if lieux is defined and lieux is not empty %}
                        {% for lieu in lieux %}
                            <option value="{{ lieu.idLocal }}"
                                {% if app.request.get('lieu') == lieu.idLocal %}selected{% endif %}>
                                {{ lieu.adresse }}
                            </option>
                        {% endfor %}
                    {% else %}
                        <option disabled>Aucun lieu disponible</option>
                    {% endif %}
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" name="capacite">
                    <option value="">Capacité</option>
                    <option value="20-50" {% if app.request.get('capacite') == '20-50' %}selected{% endif %}>20-50 invités</option>
                    <option value="50-100" {% if app.request.get('capacite') == '50-100' %}selected{% endif %}>50-100 invités</option>
                    <option value="100+" {% if app.request.get('capacite') == '100+' %}selected{% endif %}>100+ invités</option>
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select" name="type">
                    <option value="">Type d'événement</option>
                    <option value="Mariage" {% if app.request.get('type') == 'Mariage' %}selected{% endif %}>Mariage</option>
                    <option value="Conférence" {% if app.request.get('type') == 'Conférence' %}selected{% endif %}>Conférence</option>
                    <option value="Fête" {% if app.request.get('type') == 'Fête' %}selected{% endif %}>Fête</option>
                    <option value="Autre" {% if app.request.get('type') == 'Autre' %}selected{% endif %}>Autre</option>
                </select>
            </div>
            <div class="col-md-3">
                <input type="date" class="form-control" name="date"
                       value="{{ app.request.get('date') }}">
            </div>
            <div class="col-md-1">
                <button class="btn btn-primary w-100">
                    <i class="fas fa-search"></i>
                </button>
            </div>
        </div>
    </form>
</div>

</form>


    <!-- Catalogue -->
    <div class="row g-4">
        {% for pack in packs|sort((a, b) => b.dateCreation <=> a.dateCreation) %}
            <div class="col-md-6 col-lg-4">
                <div class="pack-card h-100">
                    <a href="{{ path('cattagPack_show', {'id': pack.packId}) }}" class="text-decoration-none">
                        <div class="card border-0 shadow-hover h-100">
                            <div class="position-relative">
                                {% if pack.photo %}
                                    <img src="{{ asset('uploads/packs/' ~ pack.photo) }}" 
                                         class="card-img-top" 
                                         alt="{{ pack.nom }}"
                                         style="height: 250px; object-fit: cover;">
                                {% else %}
                                    <div class="card-img-top bg-light d-flex align-items-center justify-content-center" 
                                         style="height: 250px;">
                                        <i class="fas fa-image fa-3x text-muted"></i>
                                    </div>
                                {% endif %}
                                
                                {% if date(pack.dateCreation) > date('-24hours') %}
                                    <div class="position-absolute top-0 end-0 m-3">
                                        <span class="badge bg-warning text-dark">NOUVEAU</span>
                                    </div>
                                {% endif %}
                            </div>

                            <div class="card-body p-4">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="h5 mb-0 text-dark">{{ pack.nom }}</h3>
                                    <span class="badge bg-primary">{{ pack.type }}</span>
                                </div>

                                <div class="mb-3">
                                    <div class="text-muted small mb-2">
                                        <i class="fas fa-map-marker-alt me-2"></i>
                                        {% if pack.lieu %}
                                            <a href="#" class="text-decoration-none text-muted">
                                                {{ pack.lieu.adresse }}
                                            </a>
                                        {% endif %}
                                    </div>
                                    <div class="text-primary h4 mb-0">{{ pack.prix }} DT</div>
                                </div>

                                <div class="border-top pt-3 mt-3">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            <div class="d-flex align-items-center text-muted small">
                                                <i class="fas fa-users me-2"></i>
                                                <span>{{ pack.nbreInvitesMax }} invités max</span>
                                            </div>
                                        </div>
                                        <div class="col text-end">
                                            <a href="{{ path('cattagPack_show', {'id': pack.packId}) }}" class="btn btn-primary">
                                                <i class="fas fa-eye me-2"></i>Voir détails
                                            </a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info text-center p-5">
                    <i class="fas fa-info-circle fa-3x mb-3"></i>
                    <h4>Aucun pack disponible</h4>
                    <p class="mb-0">Nous mettons à jour notre catalogue. Revenez bientôt !</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<style>
    .pack-card {
        transition: all 0.3s ease;
    }

    .shadow-hover {
        transition: all 0.3s ease;
    }

    .pack-card:hover .shadow-hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.1) !important;
    }

    .badge {
        padding: 0.5em 1em;
        font-weight: 500;
    }

    .btn-outline-primary {
        border-width: 2px;
    }

    .btn-outline-primary:hover {
        transform: translateY(-2px);
    }

    .filters-bar {
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.1);
    }

    .form-select, .form-control {
        border: 1px solid #e0e0e0;
        padding: 0.75rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
    }

    .form-select:focus, .form-control:focus {
        border-color: var(--bs-primary);
        box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.25);
    }

    @media (max-width: 768px) {
        .pack-card .card-img-top {
            height: 200px !important;
        }
    }
</style>
{% endblock %}
