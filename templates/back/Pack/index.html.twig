{% extends 'back/index.html.twig' %}

{% block title %}Gestion des Packs{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0 text-gray-800">Gestion des Packs</h1>
        <a href="{{ path('back_pack_new') }}" class="btn btn-primary">
            <i class="fas fa-plus"></i> Ajouter un pack
        </a>
    </div>

    {# 🚨 Ajoute ce bloc ici pour afficher le message flash après redirection #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endfor %}


    <div class="row">
        {% for pack in packs %}
            <div class="col-md-4 mb-4" data-pack-id="{{ pack.packId }}">
                <div class="card h-100">
                    {% if pack.photo %}
                        <img src="{{ asset('uploads/packs/' ~ pack.photo) }}" class="card-img-top" alt="{{ pack.nom }}" style="height: 200px; object-fit: cover;">
                    {% else %}
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                            <i class="fas fa-image fa-3x text-muted"></i>
                        </div>
                    {% endif %}
                    
                    <div class="card-body">
                        <h5 class="card-title">{{ pack.nom }}</h5>
                        <p class="card-text">
                            <span class="badge bg-primary">{{ pack.type }}</span>
                            <span class="badge bg-success">{{ pack.prix }} DT</span>
                            <span class="badge bg-{{ pack.statut == 'actif' ? 'success' : 'danger' }}">
                                {{ pack.statut }}
                            </span>
                        </p>
                        <p class="card-text">{{ pack.description|slice(0, 100) }}...</p>
                    </div>
                    
                    <div class="card-footer bg-transparent">
                        <div class="btn-group w-100">
                            <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#packModal" data-action="view" data-id="{{ pack.packId }}">
                                <i class="fas fa-eye"></i>
                            </button>
                            <a href="{{ path('back_pack_edit', {'id': pack.packId}) }}" class="btn btn-warning">
                                <i class="fas fa-edit"></i>
                            </a>
                            <button type="button" class="btn btn-danger delete-pack" data-pack-id="{{ pack.packId }}">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12">
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> Aucun pack trouvé.
                </div>
            </div>
        {% endfor %}
    </div>
</div>

<!-- Modal pour le formulaire -->
<div class="modal fade" id="packModal" tabindex="-1" aria-labelledby="packModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="packModalLabel">Nouveau Pack</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Le contenu sera chargé dynamiquement via AJAX -->
            </div>
        </div>
    </div>
</div>

<!-- Modal pour la suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirmation de suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <!-- Le contenu sera chargé dynamiquement via AJAX -->
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const packModal = document.getElementById('packModal');
    
    // Gestion des événements pour le modal des packs
    packModal.addEventListener('show.bs.modal', function(event) {
        const button = event.relatedTarget;
        const action = button.getAttribute('data-action');
        const id = button.getAttribute('data-id');
        const modalTitle = packModal.querySelector('.modal-title');
        const modalBody = packModal.querySelector('.modal-body');
        
        let url;
        if (action === 'view') {
            url = `/back/pack/${id}/view`;
            modalTitle.textContent = 'Détails du Pack';
        } else if (action === 'edit') {
            url = `/back/pack/${id}/edit`;
            modalTitle.textContent = 'Modifier le Pack';
        } else {
            url = '/back/pack/new';
            modalTitle.textContent = 'Nouveau Pack';
        }
        
        fetch(url)
            .then(response => response.text())
            .then(html => {
                modalBody.innerHTML = html;
            });
    });

    // Gestion du clic sur le bouton de suppression
    document.querySelectorAll('.delete-pack').forEach(button => {
        button.addEventListener('click', function() {
            const id = this.getAttribute('data-pack-id');
            
            if (confirm('Êtes-vous sûr de vouloir supprimer ce pack ?')) {
                // Créer un formulaire pour la suppression
                const formData = new FormData();
                formData.append('_token', '{{ csrf_token('delete') }}');
                
                fetch(`/back/pack/${id}/delete`, {
                    method: 'POST',
                    body: formData,
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Erreur réseau');
                    }
                    return response.json();
                })
                .then(data => {
                    if (data.success) {
                        // Supprimer la carte du pack
                        const card = document.querySelector(`[data-pack-id="${id}"]`);
                        if (card) {
                            card.remove();
                        }
                        // Afficher un message de succès
                        Swal.fire({
                            icon: 'success',
                            title: 'Succès',
                            text: data.message || 'Pack supprimé avec succès',
                            timer: 2000,
                            showConfirmButton: false
                        });
                    } else {
                        throw new Error(data.message || 'Erreur lors de la suppression');
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    Swal.fire({
                        icon: 'error',
                        title: 'Erreur',
                        text: error.message || 'Une erreur est survenue lors de la suppression du pack',
                        timer: 2000,
                        showConfirmButton: false
                    });
                });
            }
        });
    });
    
    // Gestion de la soumission du formulaire d'édition
    packModal.addEventListener('submit', function(event) {
        if (event.target.tagName === 'FORM') {
            event.preventDefault();
            const formData = new FormData(event.target);
            
            fetch(event.target.action, {
                method: 'POST',
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    // Afficher un message de succès
                    Swal.fire({
                        icon: 'success',
                        title: 'Succès',
                        text: data.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                    
                    // Fermer le modal
                    const modal = bootstrap.Modal.getInstance(packModal);
                    modal.hide();
                    
                    // Recharger la page pour afficher les modifications
                    window.location.reload();
                } else {
                    packModal.querySelector('.modal-body').innerHTML = data.html;
                }
            });
        }
    });
});
</script>
{% endblock %} 