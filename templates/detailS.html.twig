{% extends 'base1.html.twig' %}

{% block title %}Détails du service -
	{{ service.nomService }}
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		/* Styles spécifiques à cette page */
		.modal-content {
			border-radius: 10px;
		}

		.btn-orange {
			background-color: #fd7e14;
			color: white;
			border-color: #fd7e14;
		}

		.btn-orange:hover {
			background-color: #e67312;
			border-color: #e67312;
		}

		.text-orange {
			color: #fd7e14;
		}

		.service-image {
			max-height: 400px;
			object-fit: cover;
			box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
		}

		.badge {
			font-size: 0.9rem;
			padding: 0.5em 0.75em;
		}
	</style>
{% endblock %}

{% block content %}
	<section class="container py-5">
		<div class="row">
			<div class="col-md-6">
				{% if service.imageUrl %}
					<img src="{{ asset('uploads/' ~ service.imageUrl) }}" class="img-fluid rounded service-image" alt="{{ service.nomService }}">
				{% endif %}
			</div>
			<div class="col-md-6">
				<h1 class="mb-4">{{ service.nomService }}</h1>

				<div class="d-flex align-items-center mb-3">
					<span class="badge bg-{{ service.typeService == 'Matériel' ? 'info' : 'warning' }} me-3">
						{{ service.typeService }}
					</span>
					<div class="d-flex align-items-center mb-3">

						<span class="{{ service.disponibilite > 0 ? 'text-success' : 'text-danger' }}">
							<i class="bi {{ service.disponibilite > 0 ? 'bi-check-circle-fill' : 'bi-x-circle-fill' }}"></i>
							{{ service.disponibilite > 0 ? service.disponibilite ~ ' disponibles' : 'Non disponible' }}
						</span>
					</div>
				</div>

				<h3 class="text-orange">{{ service.prix }}
					DT</h3>

				<div class="mt-4">
					<h4>Description complète</h4>
					<p class="lead">{{ service.description }}</p>
				</div>

				<div class="mt-5">
					<a href="{{ path('app_catalogue_servicesM') }}" class="btn btn-outline-secondary">
						<i class="bi bi-arrow-left"></i>
						Retour au catalogue
					</a>
					<button class="btn btn-orange ms-2" data-bs-toggle="modal" data-bs-target="#reservationModal">
						<i class="bi bi-cart-plus"></i>
						Réserver
					</button>
				</div>
			</div>
		</div>

		<!-- Modal de réservation -->
		<div class="modal fade" id="reservationModal" tabindex="-1" aria-labelledby="reservationModalLabel" aria-hidden="true">
			<div class="modal-dialog">
				<div class="modal-content">
					<div class="modal-header">
						<h5 class="modal-title" id="reservationModalLabel">Réservation -
							{{ service.nomService }}</h5>
						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
					</div>
					<div class="modal-body">
						{{ form_start(reservationForm, {
                    'action': path('app_reservation_new', {'id': service.idService}),
                    'attr': {
                        'class': 'needs-validation',
                        'novalidate': 'novalidate',
                        'id': 'reservation-form'
                    }
                }) }}

						{# Dans votre formulaire #}
						<div class="mb-3">
							{{ form_label(reservationForm.quantite, 'Quantité', {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(reservationForm.quantite, {
        'attr': {
            'class': 'form-control' ~ (reservationForm.quantite.vars.errors|length ? ' is-invalid' : ''),
            'min': 1,
            'max': service.quantiteMateriel
        }
    }) }}
							{% if reservationForm.quantite.vars.errors|length %}
								<div class="invalid-feedback">
									{% for error in reservationForm.quantite.vars.errors %}
										{{ error.message }}
									{% endfor %}
								</div>
							{% endif %}
							<small class="form-text text-muted">
								Quantité disponible:
								{{ service.quantiteMateriel }}
							</small>
						</div>

						<div class="mb-3">
							{{ form_label(reservationForm.dateReservation, 'Date de réservation', {'label_attr': {'class': 'form-label'}}) }}
							{{ form_widget(reservationForm.dateReservation, {
        'attr': {
            'class': 'form-control' ~ (reservationForm.dateReservation.vars.errors|length ? ' is-invalid' : ''),
            'min': "now"|date("Y-m-d\TH:i")
        }
    }) }}
							{% if reservationForm.dateReservation.vars.errors|length %}
								<div class="invalid-feedback">
									{% for error in reservationForm.dateReservation.vars.errors %}
										{{ error.message }}
									{% endfor %}
								</div>
							{% endif %}
							<small class="form-text text-muted">
								Heures d'ouverture: 9h - 18h
							</small>
						</div>

						<div class="d-grid">
							<button type="submit" class="btn btn-orange">Réserver</button>
						</div>

						{{ form_end(reservationForm) }}
					</div>
				</div>
			</div>
		</div>
	{% endblock %}
	